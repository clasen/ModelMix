{
  "name": "modelmix",
  "version": "5.7.1",
  "description": "🧬 Reliable interface with automatic fallback for AI LLMs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clasen/ModelMix.git"
  },
  "keywords": [
    "mcp",
    "skill",
    "llm",
    "ai",
    "model",
    "openai",
    "anthropic",
    "agent",
    "realtime",
    "gpt",
    "claude",
    "llama",
    "fallback",
    "kimi",
    "mythos",
    "gpt6",
    "astra",
    "muse",
    "spark",
    "opus",
    "fable",
    "sonnet",
    "openrouter",
    "gemini",
    "qwen",
    "glm",
    "lmstudio",
    "deepseek",
    "oss",
    "reasoning",
    "minimax",
    "thinking",
    "fireworks",
    "litellm",
